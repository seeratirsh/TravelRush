<style>
  .search-btn {
    background-color: #fe424d;
    color: white;
    border-radius: 25px;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    border: none;
    white-space: nowrap;
  }
  .search-btn:hover { background-color: #e03a45; color: white; }
  .search-btn i { display: inline; margin-right: 0.4rem; }
  .search-inp {
    border-radius: 25px;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
  }
</style>

<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top shadow-sm">
  <div class="container-fluid px-3">
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>
    <button class="navbar-toggler" type="button"
      data-bs-toggle="collapse" data-bs-target="#mainNavbar"
      aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNavbar">
      <div class="navbar-nav me-2">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- ✅ Search form submits to /listings?search=... -->
      <form class="d-flex flex-grow-1 my-2 my-md-0 me-md-3" role="search" action="/listings" method="GET">
        <input
          class="form-control me-2 search-inp flex-grow-1"
          type="search"
          name="search"
          value="<%= typeof search !== 'undefined' ? search : '' %>"
          placeholder="Search destinations" />
        <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>Search
        </button>
      </form>

      <div class="navbar-nav ms-auto align-items-md-center gap-1">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
        <% if (currUser) { %>
          <a class="nav-link" href="/logout">Log out</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
